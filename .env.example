# ============================================================
#  Variables de entorno — copiá este archivo a .env.local
#  y completá con tus credenciales reales.
#  NUNCA subas .env.local al repo (ya está en .gitignore).
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key   # secreto, solo en el servidor

# ── Mercado Pago ────────────────────────────────────────────
# IMPORTANTE: las DOS credenciales deben ser de la MISMA aplicación.
# Para la DEMO usá el par de la sección "Credenciales de PRUEBA".
#   Panel MP → Tus integraciones → tu app → Pruebas → Credenciales de prueba
# OJO: las credenciales de prueba nuevas empiezan con APP_USR- (igual que producción);
#      lo que importa es sacarlas de "Credenciales de prueba", no de "Producción".
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx            # Access Token de prueba (secreto, servidor)
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-xxxxxxxx  # Public Key de prueba (de la misma app)

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app
ADMIN_EMAIL=tu@email.com
NEXT_PUBLIC_ADMIN_EMAIL=tu@email.com
